# Copy to .env and fill in. Never commit .env.

# AI brainstorm (optional) — set one of these
NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MUSIC_MODEL=google/gemma-4-31b-it

# Recommended on a public server: require a password (any username works)
APP_PASSWORD=

# Port on the server (127.0.0.1 only) that your reverse proxy / tunnel forwards to.
# Change it if 8090 is already used by another site.
HOST_PORT=8090

# Limits. Cloudflare's free plan rejects uploads over 100 MB, so stay below that.
MAX_UPLOAD_MB=95
MAX_FILES=10
JOB_TTL_HOURS=24
