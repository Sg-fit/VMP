# Copy to .env and fill in. Never commit .env.

# AI brainstorm (optional) — set one of these
NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MUSIC_MODEL=google/gemma-4-31b-it

# Recommended on a public server: require a password (any username works)
APP_PASSWORD=

# Port on the server (127.0.0.1 only) that your reverse proxy / tunnel forwards to.
# Change it if 8090 is already used by another site.
HOST_PORT=8090

# Limits. Cloudflare's free plan rejects uploads over 100 MB, so stay below that.
MAX_UPLOAD_MB=95
MAX_FILES=10
JOB_TTL_HOURS=24

# Instrument separation: drums vs everything else.
#   WITH_DEMUCS=1 builds the Docker image with Demucs (AI separation; ~1 GB bigger, ~1-2 min per track)
#   MUSIC_SEPARATION=auto (Demucs if installed) | demucs | simple (fast built-in split)
WITH_DEMUCS=0
MUSIC_SEPARATION=auto

# Resource caps for the Docker container (protects other sites on the same server).
CPU_LIMIT=1.0
MEM_LIMIT=1500m

# AI speed: ask a backup model in parallel after N seconds; give up after M seconds.
# Run `docker compose exec music-analyzer python musicanalyze.py --bench-llm` to find the fastest model.
MUSIC_AI_HEDGE_SECONDS=30
MUSIC_AI_DEADLINE_SECONDS=150
